{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_gate_result.schema.json",
  "title": "Work1 V11 M4 EvidenceGateResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id", "status", "checks", "resolved_evidence", "missing_evidence", "warnings", "rejection_reasons", "provenance"],
  "properties": {
    "proposal_id": {"type": "string", "pattern": "^proposal-[0-9a-f]{24}$"},
    "status": {"enum": ["ADMISSIBLE", "NEEDS_MORE_EVIDENCE", "REJECTED", "DUPLICATE", "ALREADY_SUPPORTED", "UNSUPPORTED"]},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["check", "status", "details"], "properties": {"check": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]}, "details": {"type": "array", "items": {"type": "string"}}}}},
    "resolved_evidence": {"type": "array", "items": {"type": "object"}},
    "missing_evidence": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "rejection_reasons": {"type": "array", "items": {"type": "string"}},
    "provenance": {"type": "object", "minProperties": 1}
  }
}
